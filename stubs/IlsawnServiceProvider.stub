<?php

namespace App\Providers;

use ilsawn\LaravelIlsawn\LaravelIlsawn;
use Illuminate\Http\Request;
use Illuminate\Support\ServiceProvider;

class IlsawnServiceProvider extends ServiceProvider
{
    /**
     * Bootstrap any application services.
     */
    public function boot(): void
    {
        $this->authorization();
    }

    /**
     * Configure the Ilsawn authorization.
     *
     * By default, access is granted only in the local environment.
     * In production, uncomment the block below and add authorized emails.
     */
    protected function authorization(): void
    {
        LaravelIlsawn::auth(function (Request $request) {
            return $request->user() && in_array($request->user()->email, [
                //
            ]);
        });
    }
}
